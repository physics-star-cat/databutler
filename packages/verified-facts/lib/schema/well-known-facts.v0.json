{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databutler.dev/schema/well-known-facts.v0.json",
  "title": "Verified Facts discovery document (/.well-known/facts.json)",
  "description": "Published at https://<site>/.well-known/facts.json: the publisher's conformance level, namespaces, endpoints and keys. Specification: https://databutler.dev/protocol/facts §10.1.",
  "type": "object",
  "required": [
    "protocol",
    "publisher",
    "conformance",
    "facts",
    "namespaces",
    "hash",
    "schema"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "verified-facts/0.2",
        "verified-facts/0.3"
      ]
    },
    "publisher": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "conformance": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "required": [
        "count",
        "get",
        "index",
        "filtering"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "get": {
          "type": "string",
          "pattern": "\\{key\\}",
          "description": "RFC 6570 URI template; a static publisher serves …/f/{key}.json."
        },
        "page": {
          "type": "string",
          "pattern": "\\{key\\}",
          "description": "0.3, optional: RFC 6570 URI template of the fact's HTML page, served text/html to every caller."
        },
        "batch": {
          "type": "string"
        },
        "resolve": {
          "type": "string"
        },
        "index": {
          "type": "string",
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "0.3: SHA-256 over the JCS form of the sorted [key, hash] pairs of every fact served (spec §5.6). Required by L1 under 0.3; checked by the conformance checker."
        },
        "filtering": {
          "enum": [
            "server",
            "client"
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "namespaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "count",
          "authorities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[a-z0-9]{1,3})?$|^[a-z]{3,}[a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "cadence": {
            "type": "string"
          },
          "authorities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "0.3: the digest over this namespace's facts."
          }
        }
      }
    },
    "hash": {
      "const": "sha256/jcs"
    },
    "signature": {
      "const": "EdDSA/jws-detached"
    },
    "keys": {
      "type": "string",
      "format": "uri"
    },
    "changes": {
      "type": "string",
      "format": "uri"
    },
    "openapi": {
      "type": "string",
      "format": "uri"
    },
    "mcp": {
      "type": "object",
      "required": [
        "url",
        "tools"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serverCard": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "schema": {
      "type": "string",
      "format": "uri"
    },
    "specification": {
      "type": "string",
      "format": "uri"
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "format": "uri"
    }
  }
}
