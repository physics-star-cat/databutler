{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/schema/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/f",
      "destination": "/api/router?route=f"
    },
    {
      "source": "/f/(.*)",
      "destination": "/api/router?route=f&key=$1"
    },
    {
      "source": "/facts",
      "destination": "/api/router?route=f"
    },
    {
      "source": "/protocol/facts",
      "destination": "/api/router?route=protocol&doc=facts"
    },
    {
      "source": "/api/mcp/server-card",
      "destination": "/api/router?route=server-card&server=databutler"
    },
    {
      "source": "/api/mcp/(.+)/server-card",
      "destination": "/api/router?route=server-card&server=$1"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/router?route=r&path=$1"
    },
    {
      "source": "/changes",
      "destination": "/api/router?route=changes-page"
    },
    {
      "source": "/changes.rss",
      "destination": "/api/router?route=changes-feed&format=rss"
    },
    {
      "source": "/changes.atom",
      "destination": "/api/router?route=changes-feed&format=atom"
    },
    {
      "source": "/protocol",
      "destination": "/api/router?route=protocol"
    },
    {
      "source": "/api/(.+)",
      "destination": "/api/router?route=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/watch-sources",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "includeFiles": "{docs/CHANGES_PROTOCOL.md,docs/FACTS_PROTOCOL.md,public/schema/**,api/_areas/**,data/**}"
    }
  }
}
